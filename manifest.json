{
  "manifest_version": 3,
  "name": "Jira Task Plus",
  "version": "2.0.0",
  "description": "Bulk create Jira tasks from Story and Epic pages.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://outlook.cloud.microsoft/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["tracker/tracker-widget.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.cloud.microsoft/*",
        "*://outlook.live.com/*"
      ],
      "js": ["calendar/calendar-relay.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jira Task Plus — Right-click for options"
  },
  "options_ui": {
    "page": "settings/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["modal/modal.html", "modal/modal.js", "assets/styles.css", "assets/icon16.png"],
      "matches": ["*://*.atlassian.net/*"]
    },
    {
      "resources": ["calendar/calendar-relay.js"],
      "matches": ["*://outlook.office.com/*", "*://outlook.office365.com/*", "*://outlook.cloud.microsoft/*"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
